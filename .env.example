# ======================================================================
# AI Research Assistant Platform - environment configuration
# Copy to `.env` and fill in the values you need.
# Everything below has a sensible default; only the LLM key is required
# for the full pipeline. Use LLM_PROVIDER=fake to run with zero keys.
# ======================================================================

# ---------------------------------------------------------------- LLM --
# Provider: "openai" (any OpenAI-compatible endpoint) or "fake" (offline demo)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Optional endpoint override (OpenRouter, vLLM, Ollama, Azure gateway...):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=1024

# ------------------------------------------------------------- RAG ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
COLLECTION_NAME=research_documents

# ------------------------------------------------------------- Agents -
MAX_GRAPH_ITERATIONS=3
MAX_RESEARCH_TOOL_CALLS=6
ENABLE_WEB_RESEARCH=true
ENABLE_LOOP_REFINEMENT=true

# ------------------------------------------------- External services --
# Optional: live web search (the app degrades gracefully without it)
TAVILY_API_KEY=

# ------------------------------------------------------- LangSmith ----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-research-assistant

# ------------------------------------------------------------- API ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ------------------------------------------------------ Storage paths -
DATA_DIR=./data
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/checkpoints.sqlite
NOTES_PATH=./data/notes/notes.jsonl